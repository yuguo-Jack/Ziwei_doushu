# Optional: useful when invoking the installed CLI from another workspace.
# PowerShell: $env:ZIWEI_KB_ROOT = (Get-Location).Path
# ZIWEI_KB_ROOT=/absolute/path/to/Ziwei_doushu

# Optional native Codex executable and model override. Login via `codex login`.
# ZIWEI_CODEX_CLI=/absolute/path/to/codex.exe
# ZIWEI_CODEX_MODEL=your-available-model

# Optional embeddable TrueType CJK font for PDF on non-Windows systems.
# ZIWEI_REPORT_FONT=/absolute/path/to/chinese-font.ttf

# This file is a reference; the app reads process environment variables,
# and does not automatically load .env files. Never put account tokens here.
